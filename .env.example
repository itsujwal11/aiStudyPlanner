# ============================================================
# AASA - Environment Configuration Template
# Copy the relevant section into backend/.env and frontend/.env
# Every key below is actually read by the code.
# ============================================================

## Backend (.env) - loaded via spring.config.import
## (backend/.env or repository-root .env; OS env vars take precedence)

# Server (default if unset: 9096)
PORT=9096

# Database (PostgreSQL + pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aasa_db
DB_USERNAME=aasa_user
DB_PASSWORD=aasa_password

# Security
# Minimum 32 chars. Generate with: openssl rand -base64 32
JWT_SECRET=change_me_this_is_not_secure_min_32_characters_long
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Google Gemini (required for analysis, quizzes, embeddings, RAG answers)
GEMINI_API_KEY=your_gemini_api_key_here

# Mail / OTP verification (SMTP_ENABLED=false logs codes to server log instead)
SMTP_ENABLED=false
SMTP_FROM=no-reply@aasa.local
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
OTP_EXPIRATION_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60

# Weakness model service (ml/serve.py)
# Fail-soft: when disabled or unreachable, weakness scoring uses the
# deterministic evidence formula alone and the app stays fully usable.
ML_WEAKNESS_ENABLED=true
ML_WEAKNESS_URL=http://localhost:8000
ML_WEAKNESS_TIMEOUT_MS=1500

## Frontend (.env)
VITE_API_URL=http://localhost:9096/api
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id

# ------------------------------------------------------------
# Notes
# - CORS origins, upload directory, multipart limits, JWT expiry and logging
#   levels are NOT env-driven; they live in
#   backend/src/main/resources/application.properties.
# - Never commit real .env files to version control.
# ------------------------------------------------------------
